{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://air.dev/schema/check-target-0.1.schema.json",
  "title": "AIR check target",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "air.dev/check-target/v0.1"
    },
    "kind": {
      "const": "CheckTarget"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "http",
            "command"
          ]
        },
        "fixtureIsolation": {
          "enum": [
            "process",
            "reset-command"
          ]
        },
        "workingDirectory": {
          "$ref": "#/$defs/relativePath"
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "baseUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "baseUrlEnv": {
          "$ref": "#/$defs/envName"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "observationPath": {
          "type": "string",
          "pattern": "^/",
          "default": "/_air/observations/{scenario}"
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start": {
              "$ref": "#/$defs/command"
            },
            "reset": {
              "$ref": "#/$defs/command"
            },
            "readiness": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^/"
                },
                "timeoutMs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 300000
                }
              }
            },
            "services": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "command"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "command": {
                    "$ref": "#/$defs/command"
                  },
                  "readinessUrl": {
                    "type": "string",
                    "pattern": "^https?://"
                  },
                  "timeoutMs": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 300000
                  }
                }
              }
            }
          }
        },
        "evidenceCaptureProfile": {
          "$ref": "#/$defs/relativePath"
        },
        "headers": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9-]{1,64}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fromEnv"
            ],
            "properties": {
              "fromEnv": {
                "$ref": "#/$defs/envName"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "http"
              }
            }
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "baseUrl": true
                },
                "required": [
                  "baseUrl"
                ]
              },
              {
                "properties": {
                  "baseUrlEnv": true
                },
                "required": [
                  "baseUrlEnv"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "command"
              }
            }
          },
          "then": {
            "properties": {
              "command": true
            },
            "required": [
              "command"
            ]
          }
        }
      ]
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
      }
    },
    "envName": {
      "type": "string",
      "pattern": "^[A-Z_][A-Z0-9_]*$"
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fromEnv"
        ],
        "properties": {
          "fromEnv": {
            "$ref": "#/$defs/envName"
          }
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "workingDirectory": {
          "$ref": "#/$defs/relativePath"
        },
        "environment": {
          "$ref": "#/$defs/environment"
        }
      }
    }
  }
}
