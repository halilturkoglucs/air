{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://air.dev/schema/capability-0.1.schema.json", "title": "AIR Extracted Capability v0.1",
  "type": "object", "additionalProperties": false, "required": ["apiVersion", "kind", "capabilityId", "discoveryRepositoryHash", "evidenceHash", "nodes", "blockers", "adopted"],
  "properties": { "apiVersion": { "const": "air.dev/capability/v0.1" }, "kind": { "const": "ExtractedCapability" }, "capabilityId": { "type": "string", "minLength": 1 }, "discoveryRepositoryHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "evidenceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "nodes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }, "blockers": { "type": "array", "items": { "type": "string" } }, "adopted": { "type": "boolean" } }
}
