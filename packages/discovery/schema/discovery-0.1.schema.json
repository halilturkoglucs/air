{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://air.dev/schema/discovery-0.1.schema.json", "title": "AIR Discovery Manifest v0.1",
  "type": "object", "additionalProperties": false, "required": ["apiVersion", "kind", "metadata", "files"],
  "properties": {
    "apiVersion": { "const": "air.dev/discovery/v0.1" }, "kind": { "const": "DiscoveryBundle" },
    "metadata": { "type": "object", "additionalProperties": false, "required": ["name", "repository", "repositoryHash", "createdAt", "updatedAt", "analyzer", "analyzerVersion"], "properties": { "name": { "type": "string", "minLength": 1 }, "repository": { "type": "string", "minLength": 1 }, "repositoryHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "createdAt": { "type": "string", "minLength": 1 }, "updatedAt": { "type": "string", "minLength": 1 }, "analyzer": { "type": "string", "minLength": 1 }, "analyzerVersion": { "type": "string", "minLength": 1 } } },
    "files": { "type": "object", "additionalProperties": false, "required": ["nodes", "edges", "evidence", "decisions", "coverage", "index"], "properties": { "nodes": { "const": "nodes.jsonl" }, "edges": { "const": "edges.jsonl" }, "evidence": { "const": "evidence.jsonl" }, "decisions": { "const": "decisions.yaml" }, "coverage": { "const": "coverage.json" }, "index": { "const": "index.sqlite" } } }
  },
  "$defs": {
    "source": { "type": "object", "additionalProperties": false, "required": ["path", "contentHash"], "properties": { "path": { "type": "string", "minLength": 1 }, "startLine": { "type": "integer", "minimum": 1 }, "endLine": { "type": "integer", "minimum": 1 }, "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "symbol": { "type": "string" }, "buildCoordinate": { "type": "string" } } },
    "confidence": { "enum": ["proven", "observed", "inferred", "opaque", "conflicting"] },
    "node": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "name", "confidence", "observable", "attributes", "sources"], "properties": { "id": { "type": "string" }, "kind": { "enum": ["module", "service", "endpoint", "contract", "entity", "table", "transaction", "listener", "publisher", "schedule", "cache", "vendor-call", "configuration", "repository", "query", "mapper", "security", "operation", "foreign-operation", "dynamic-routing"] }, "name": { "type": "string" }, "qualifiedName": { "type": "string" }, "module": { "type": "string" }, "confidence": { "$ref": "#/$defs/confidence" }, "observable": { "type": "boolean" }, "attributes": { "type": "object" }, "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } }, "evidenceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "diagnostics": { "type": "array", "items": { "type": "string" } } } },
    "edge": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "from", "to", "confidence", "sources"], "properties": { "id": { "type": "string" }, "kind": { "enum": ["contains", "calls", "reads", "writes", "publishes", "consumes", "maps", "guards", "configures", "depends-on"] }, "from": { "type": "string" }, "to": { "type": "string" }, "confidence": { "$ref": "#/$defs/confidence" }, "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } }, "evidenceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } } } },
    "evidence": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "observedAt", "source", "nodeIds", "attributes", "redacted"], "properties": { "id": { "type": "string" }, "kind": { "enum": ["trace", "test", "database-change", "message", "schema-contract", "outbound-call"] }, "observedAt": { "type": "string", "minLength": 1 }, "source": { "type": "string" }, "nodeIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }, "attributes": { "type": "object", "additionalProperties": { "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }, { "type": "null" }] } }, "redacted": { "type": "boolean" } } },
    "decision": { "type": "object", "additionalProperties": false, "required": ["subjectId", "action", "evidenceHash", "decidedAt"], "properties": { "subjectId": { "type": "string" }, "action": { "enum": ["approve", "reject", "rename", "merge", "mark-opaque"] }, "value": { "type": "string" }, "evidenceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "decidedAt": { "type": "string", "minLength": 1 }, "reviewer": { "type": "string" }, "invalidated": { "type": "boolean" }, "reason": { "type": "string" } } }
  }
}
