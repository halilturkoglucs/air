{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://air.dev/schema/adoption-0.2.schema.json", "title": "AIR Capability Adoption v0.2",
  "type": "object", "additionalProperties": false, "required": ["apiVersion", "kind", "capabilityId", "evidenceHash", "adoptedAt", "ownership"],
