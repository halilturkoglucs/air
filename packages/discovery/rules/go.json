{
  "ecosystem": "go",
  "extensions": [
    ".go"
  ],
  "lineComment": "//",
  "seams": [
    {
      "kind": "http",
      "framework": "net/http",
      "pattern": "\\.HandleFunc\\(\\s*\"(?:(GET|POST|PUT|PATCH|DELETE|HEAD)\\s+)?(/[^\"]*)\"",
      "method": 1,
      "route": 2,
      "defaultMethod": "ANY"
    },
    {
      "kind": "http",
      "framework": "gin-echo",
      "pattern": "\\b\\w+\\.(GET|POST|PUT|PATCH|DELETE|HEAD)\\(\\s*\"(/[^\"]*)\"",
      "method": 1,
      "route": 2
    },
    {
      "kind": "http",
      "framework": "chi",
      "pattern": "\\b\\w+\\.(Get|Post|Put|Patch|Delete|Head)\\(\\s*\"(/[^\"]*)\"",
      "method": 1,
      "route": 2
    },
    {
      "kind": "cli",
      "framework": "go",
      "pattern": "^func\\s+main\\(\\)",
      "name": 0
    }
  ],
  "effects": [
    {
      "kind": "database",
      "pattern": "[\"'`]\\s*(?:SELECT\\b[^\"'`;]{0,200}?\\bFROM|INSERT\\s+INTO|DELETE\\s+FROM)\\s+[`\"\\[]?([A-Za-z_][\\w.]*)",
      "name": 1,
      "flags": "i"
    },
    {
      "kind": "database",
      "pattern": "[\"'`]\\s*UPDATE\\s+[`\"\\[]?([A-Za-z_][\\w.]*)[`\"\\]]?\\s+SET\\b",
      "name": 1,
      "flags": "i"
    },
    {
      "kind": "database",
      "pattern": "\\.Collection\\(\\s*\"([\\w.-]+)\"\\s*\\)",
      "name": 1
    },
    {
      "kind": "outbound",
      "pattern": "\\bhttp\\.(?:Get|Post|NewRequest(?:WithContext)?)\\([^\"]*\"(https?://[^\"\\s]+)",
      "name": 1
    },
    {
      "kind": "message",
      "pattern": "\\bTopic:\\s*\"([^\"]+)\"",
      "name": 1
    },
    {
      "kind": "database",
      "pattern": "\\.Model\\(\\s*&?(\\w+)\\s*\\{",
      "name": 1
    },
    {
      "kind": "database",
      "pattern": "\\.AutoMigrate\\(\\s*&?(\\w+)\\s*\\{",
      "name": 1
    }
  ],
  "mounts": [
    {
      "pattern": "\\b(?:\\w+\\.)?(\\w+)\\(\\s*\\w+\\.Group\\(\\s*\"([^\"]*)\"\\s*\\)\\s*\\)",
      "target": 1,
      "prefix": 2,
      "targetKind": "function"
    }
  ]
}
