{
  "ecosystem": "go",
  "extensions": [
    ".go"
  ],
  "lineComment": "//",
  "seams": [
    {
      "kind": "http",
      "framework": "net/http",
      "pattern": "\\.HandleFunc\\(\\s*\"(?:(GET|POST|PUT|PATCH|DELETE|HEAD)\\s+)?(/[^\"]*)\"",
      "method": 1,
      "route": 2,
      "defaultMethod": "ANY"
    },
    {
      "kind": "http",
      "framework": "gin-echo",
      "pattern": "\\b(\\w+)\\.(GET|POST|PUT|PATCH|DELETE|HEAD)\\(\\s*\"(/[^\"]*)\"",
      "method": 2,
      "route": 3,
      "receiver": 1
    },
    {
      "kind": "http",
      "framework": "chi",
      "pattern": "\\b(\\w+)\\.(Get|Post|Put|Patch|Delete|Head)\\(\\s*\"(/[^\"]*)\"",
      "method": 2,
      "route": 3,
      "receiver": 1
    },
    {
      "kind": "cli",
      "framework": "go",
      "pattern": "^func\\s+main\\(\\)",
      "name": 0
    },
    {
      "kind": "consumer",
      "framework": "sarama",
      "pattern": "\\bsarama\\.NewConsumer(?:Group)?\\(",
      "name": 0
    },
    {
      "kind": "consumer",
      "framework": "kafka-go",
      "pattern": "\\bkafka\\.NewReader\\(",
      "name": 0
    },
    {
      "kind": "consumer",
      "framework": "amqp",
      "pattern": "\\.Consume(?:WithContext)?\\(\\s*(?:\\w+\\s*,\\s*)?\"([^\"]+)\"",
      "name": 1
    }
  ],
  "effects": [
    {
      "kind": "database",
      "pattern": "[\"'`]\\s*(?:SELECT\\b[^\"'`;]{0,200}?\\bFROM|INSERT\\s+INTO|DELETE\\s+FROM)\\s+[`\"\\[]?([A-Za-z_][\\w.]*)",
      "name": 1,
      "flags": "i"
    },
    {
      "kind": "database",
      "pattern": "[\"'`]\\s*UPDATE\\s+[`\"\\[]?([A-Za-z_][\\w.]*)[`\"\\]]?\\s+SET\\b",
      "name": 1,
      "flags": "i"
    },
    {
      "kind": "database",
      "pattern": "\\.Collection\\(\\s*\"([\\w.-]+)\"\\s*\\)",
      "name": 1
    },
    {
      "kind": "outbound",
      "pattern": "\\bhttp\\.(?:Get|Post|NewRequest(?:WithContext)?)\\([^\"]*\"(https?://[^\"\\s]+)",
      "name": 1
    },
    {
      "kind": "message",
      "pattern": "\\bTopic:\\s*\"([^\"]+)\"",
      "name": 1
    },
    {
      "kind": "database",
      "pattern": "\\.Model\\(\\s*&?(\\w+)\\s*\\{",
      "name": 1
    },
    {
      "kind": "database",
      "pattern": "\\.AutoMigrate\\(\\s*&?(\\w+)\\s*\\{",
      "name": 1
    },
    {
      "kind": "message",
      "pattern": "\\bsarama\\.New(?:Async|Sync)Producer\\(",
      "name": "kafka"
    },
    {
      "kind": "message",
      "pattern": "\\bkafka\\.(?:NewWriter\\(|Writer\\s*\\{)",
      "name": "kafka"
    },
    {
      "kind": "message",
      "pattern": "\\.Publish(?:WithContext)?\\(\\s*\\w+\\s*,\\s*\"([^\"]*)\"\\s*,\\s*\"([^\"]+)\"",
      "name": 2
    },
    {
      "kind": "message",
      "pattern": "\\bnats\\.Connect\\(",
      "name": "nats"
    },
    {
      "kind": "cache",
      "pattern": "\\bredis\\.New(?:Client|ClusterClient|UniversalClient|FailoverClient)\\(",
      "name": "redis"
    }
  ],
  "mounts": [
    {
      "pattern": "\\b(?:\\w+\\.)?(\\w+)\\(\\s*(\\w+)\\.Group\\(\\s*\"([^\"]*)\"\\s*\\)\\s*\\)",
      "target": 1,
      "base": 2,
      "prefix": 3,
      "targetKind": "function"
    }
  ],
  "groupVars": [
    {
      "pattern": "\\b(\\w+)\\s*:?=\\s*(\\w+)\\.Group\\(\\s*\"([^\"]*)\"\\s*\\)",
      "variable": 1,
      "base": 2,
      "path": 3
    }
  ]
}
