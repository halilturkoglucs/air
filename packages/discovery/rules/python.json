{
  "ecosystem": "python",
  "extensions": [
    ".py"
  ],
  "lineComment": "#",
  "seams": [
    {
      "kind": "http",
      "framework": "flask-fastapi",
      "pattern": "@\\w+\\.(get|post|put|patch|delete|head)\\(\\s*[\"'](/?[^\"']*)",
      "method": 1,
      "route": 2
    },
    {
      "kind": "http",
      "framework": "flask",
      "pattern": "@\\w+\\.route\\(\\s*['\"](/[^'\"]*)['\"](?:[^)]*methods\\s*=\\s*\\[\\s*['\"](\\w+))?",
      "route": 1,
      "method": 2,
      "defaultMethod": "GET"
    },
    {
      "kind": "http",
      "framework": "django",
      "pattern": "\\b(?:re_)?path\\(\\s*r?[\"']([^\"']*)[\"']\\s*,\\s*(?!include\\()",
      "route": 1,
      "routePrefix": "/",
      "defaultMethod": "ANY",
      "fileFilter": "urls\\.py$",
      "regexRoute": true
    },
    {
      "kind": "http",
      "framework": "django-url",
      "pattern": "\\burl\\(\\s*r?[\"']([^\"']*)[\"']\\s*,\\s*(?!include\\()",
      "route": 1,
      "routePrefix": "/",
      "defaultMethod": "ANY",
      "fileFilter": "urls\\.py$",
      "regexRoute": true
    },
    {
      "kind": "http",
      "framework": "drf-router",
      "pattern": "\\b\\w+\\.register\\(\\s*r?[\"']([^\"']+)[\"']",
      "route": 1,
      "routePrefix": "/",
      "fileFilter": "urls\\.py$",
      "expand": [
        "GET {route}",
        "POST {route}",
        "GET {route}/:id",
        "PUT {route}/:id",
        "PATCH {route}/:id",
        "DELETE {route}/:id"
      ],
      "regexRoute": true
    },
    {
      "kind": "job",
      "framework": "celery-apscheduler",
      "pattern": "@(?:\\w+\\.)?(?:shared_task|task|scheduled_job)\\b",
      "name": 0
    },
    {
      "kind": "consumer",
      "framework": "kafka-python",
      "pattern": "\\bKafkaConsumer\\(\\s*['\"]([^'\"]+)",
      "name": 1
    },
    {
      "kind": "cli",
      "framework": "python",
      "pattern": "^if\\s+__name__\\s*==\\s*['\"]__main__['\"]",
      "name": 0
    }
  ],
  "effects": [
    {
      "kind": "database",
      "pattern": "[\"'`]\\s*(?:SELECT\\b[^\"'`;]{0,200}?\\bFROM|INSERT\\s+INTO|DELETE\\s+FROM)\\s+[`\"\\[]?([A-Za-z_][\\w.]*)",
      "name": 1,
      "flags": "i"
    },
    {
      "kind": "database",
      "pattern": "[\"'`]\\s*UPDATE\\s+[`\"\\[]?([A-Za-z_][\\w.]*)[`\"\\]]?\\s+SET\\b",
      "name": 1,
      "flags": "i"
    },
    {
      "kind": "database",
      "pattern": "\\b\\w+\\[[\"']([\\w.-]+)[\"']\\]\\.(?:find|insert|update|delete|replace|aggregate|count)",
      "name": 1
    },
    {
      "kind": "database",
      "pattern": "\\.get_collection\\(\\s*[\"']([\\w.-]+)[\"']",
      "name": 1
    },
    {
      "kind": "database",
      "pattern": "\\b([A-Z]\\w*)\\.objects\\.(?:create|filter|get|update|delete|all)",
      "name": 1
    },
    {
      "kind": "outbound",
      "pattern": "\\b(?:requests|httpx|session)\\.(?:get|post|put|patch|delete)\\(\\s*f?['\"](https?://[^'\"\\s]+)",
      "name": 1
    },
    {
      "kind": "message",
      "pattern": "\\.(?:send|produce)\\(\\s*['\"]([^'\"]+)",
      "name": 1
    },
    {
      "kind": "database",
      "pattern": "\\bselect\\(\\s*([A-Z]\\w*)\\b",
      "name": 1
    },
    {
      "kind": "database",
      "pattern": "\\bsession\\.query\\(\\s*([A-Z]\\w*)\\b",
      "name": 1
    },
    {
      "kind": "database",
      "pattern": "__tablename__\\s*=\\s*[\"'](\\w+)[\"']",
      "name": 1
    }
  ],
  "prefixes": [
    {
      "pattern": "\\bAPIRouter\\([^)]*?\\bprefix\\s*=\\s*[\"']([^\"']*)",
      "prefix": 1
    },
    {
      "pattern": "\\bBlueprint\\([^)]*?\\burl_prefix\\s*=\\s*[\"']([^\"']*)",
      "prefix": 1
    }
  ],
  "mounts": [
    {
      "pattern": "\\binclude_router\\(\\s*(\\w+)\\.router\\b[^)]*?\\bprefix\\s*=\\s*[\"']([^\"']*)[\"']",
      "target": 1,
      "prefix": 2,
      "targetKind": "module"
    },
    {
      "pattern": "\\b(?:url|path|re_path)\\(\\s*r?[\"']\\^?([^\"'$]*)\\$?[\"']\\s*,\\s*include\\(\\s*[\"']([\\w.]+)[\"']",
      "target": 2,
      "prefix": 1,
      "targetKind": "dotted"
    }
  ]
}
