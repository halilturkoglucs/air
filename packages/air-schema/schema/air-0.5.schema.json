{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://air.dev/schema/air-0.5.schema.json",
  "title": "AIR Application v0.5",
  "description": "AIR semantics with typed principals and command ownership authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "air.dev/v0.5" },
    "kind": { "const": "Application" },
    "metadata": {
      "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/metadata"
    },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "identifier": {
      "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/identifier"
    },
    "errorCode": {
      "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/errorCode"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entities"],
      "properties": {
        "entities": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": {
            "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/entity"
          }
        },
        "contracts": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": {
            "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/contract"
          }
        },
        "principals": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": {
            "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/contract"
          }
        },
        "commands": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/command" }
        },
        "http": {
          "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/http"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "effect"],
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "input": { "$ref": "#/$defs/identifier" },
        "output": {
          "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/commandOutput"
        },
        "errors": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/errorCode" },
          "additionalProperties": {
            "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/commandError"
          }
        },
        "guards": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/existsGuard"
          }
        },
        "transaction": {
          "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/transaction"
        },
        "authorization": { "$ref": "#/$defs/authorization" },
        "effect": {
          "oneOf": [
            {
              "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/createEffect"
            },
            {
              "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/updateEffect"
            }
          ]
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal", "unauthenticatedError", "rules"],
      "properties": {
        "principal": { "$ref": "#/$defs/identifier" },
        "unauthenticatedError": { "$ref": "#/$defs/errorCode" },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/inputEqualsPrincipalRule" },
              { "$ref": "#/$defs/recordFieldEqualsPrincipalRule" }
            ]
          }
        }
      }
    },
    "inputEqualsPrincipalRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "input", "principalField", "error"],
      "properties": {
        "kind": { "const": "input-equals-principal" },
        "input": { "$ref": "#/$defs/identifier" },
        "principalField": { "$ref": "#/$defs/identifier" },
        "error": { "$ref": "#/$defs/errorCode" }
      }
    },
    "recordFieldEqualsPrincipalRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "field", "principalField", "error"],
      "properties": {
        "kind": { "const": "record-field-equals-principal" },
        "field": { "$ref": "#/$defs/identifier" },
        "principalField": { "$ref": "#/$defs/identifier" },
        "error": { "$ref": "#/$defs/errorCode" }
      }
    }
  }
}
