{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://air.dev/schema/ui-0.1.schema.json",
  "title": "AIR UI v0.1",
  "description": "Framework-neutral UI intent for static, server-rendered, hybrid, and client-rendered applications.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "air.dev/ui/v0.1" },
    "kind": { "const": "UI" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 63 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "jsonValue": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "screens"],
      "properties": {
        "application": { "type": "string", "minLength": 1 },
        "implementation": { "$ref": "#/$defs/implementation" },
        "design": { "$ref": "#/$defs/design" },
        "assets": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/asset" }
        },
        "dataSources": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/dataSource" }
        },
        "screens": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/screen" }
        },
        "localization": { "$ref": "#/$defs/localization" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "extensions": { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rendering", "technology"],
      "properties": {
        "rendering": { "enum": ["static", "server", "client", "hybrid"] },
        "technology": { "type": "string", "minLength": 1, "maxLength": 120 },
        "language": { "type": "string", "minLength": 1, "maxLength": 60 },
        "framework": { "type": "string", "minLength": 1, "maxLength": 120 },
        "templateEngine": { "type": "string", "minLength": 1, "maxLength": 120 },
        "entry": { "type": "string", "minLength": 1, "maxLength": 500 },
        "hints": { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokens": { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } },
        "themes": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
        },
        "styleSheets": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "breakpoints": { "type": "object", "additionalProperties": { "anyOf": [{ "type": "string" }, { "type": "number" }] } }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source"],
      "properties": {
        "kind": { "enum": ["image", "font", "icon", "style", "script", "document", "other"] },
        "source": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 200 },
        "integrity": { "type": "string", "minLength": 1, "maxLength": 500 },
        "attributes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      }
    },
    "dataSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["static", "http", "application", "server", "custom"] },
        "operation": { "type": "string", "minLength": 1 },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"] },
        "path": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "value": { "$ref": "#/$defs/jsonValue" },
        "parameters": { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } },
        "implementation": { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      }
    },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "layout": { "$ref": "#/$defs/identifier" },
        "head": { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } },
        "load": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "root": { "$ref": "#/$defs/node" },
        "extensions": { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      }
    },
    "value": {
      "anyOf": [
        { "type": "object", "additionalProperties": false, "required": ["literal"], "properties": { "literal": { "$ref": "#/$defs/jsonValue" } } },
        { "type": "object", "additionalProperties": false, "required": ["expression"], "properties": { "expression": { "type": "string", "minLength": 1 } } },
        { "type": "object", "additionalProperties": false, "required": ["translation"], "properties": { "translation": { "type": "string", "minLength": 1 }, "parameters": { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } } } }
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["element", "component", "text", "fragment", "slot"] },
        "element": { "type": "string", "minLength": 1, "maxLength": 120 },
        "component": { "type": "string", "minLength": 1, "maxLength": 500 },
        "text": { "$ref": "#/$defs/value" },
        "slot": { "type": "string", "minLength": 1, "maxLength": 120 },
        "properties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } },
        "attributes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } },
        "styles": { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } },
        "styleRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "visibleWhen": { "type": "string", "minLength": 1 },
        "repeat": { "$ref": "#/$defs/repeat" },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "accessibility": { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } },
        "children": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "slots": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/node" } }
        },
        "implementation": { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      }
    },
    "repeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "item"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "item": { "$ref": "#/$defs/identifier" },
        "index": { "$ref": "#/$defs/identifier" },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["on", "kind"],
      "properties": {
        "on": { "type": "string", "minLength": 1, "maxLength": 120 },
        "kind": { "enum": ["navigate", "submit", "invoke", "mutate", "set-state", "toggle", "emit", "custom"] },
        "target": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "operation": { "type": "string", "minLength": 1 },
        "input": { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } },
        "when": { "type": "string", "minLength": 1 },
        "confirm": { "$ref": "#/$defs/value" },
        "implementation": { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      }
    },
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultLocale", "locales"],
      "properties": {
        "defaultLocale": { "type": "string", "minLength": 2, "maxLength": 35 },
        "locales": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2, "maxLength": 35 } },
        "direction": { "type": "object", "additionalProperties": { "enum": ["ltr", "rtl", "auto"] } },
        "catalogs": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["authored", "imported", "extracted", "generated"] },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/provenanceSource" } },
        "restrictions": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 2000 } }
      }
    },
    "provenanceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference"],
      "properties": {
        "reference": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "kind": { "enum": ["file", "url", "image", "document", "runtime", "other"] },
        "extracts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "contentHash": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    }
  }
}
