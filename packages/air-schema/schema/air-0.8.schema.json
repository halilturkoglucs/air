{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://air.dev/schema/air-0.8.schema.json",
  "title": "AIR Application v0.8",
  "description": "AIR semantics with principal roles/scopes, CRUD authorization, typed collections, and delete commands.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "air.dev/v0.8" },
    "kind": { "const": "Application" },
    "metadata": { "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/metadata" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "identifier": { "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/identifier" },
    "errorCode": { "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/errorCode" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entities"],
      "properties": {
        "entities": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/entity" }
        },
        "contracts": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/contract" }
        },
        "principals": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/contract" }
        },
        "commands": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/command" }
        },
        "http": { "$ref": "#/$defs/http" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "effect"],
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "input": { "$ref": "#/$defs/identifier" },
        "output": { "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/commandOutput" },
        "errors": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/errorCode" },
          "additionalProperties": { "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/commandError" }
        },
        "guards": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/existsGuard" }
        },
        "transaction": { "$ref": "https://air.dev/schema/air-0.7.schema.json#/$defs/transaction" },
        "authorization": { "$ref": "#/$defs/commandAuthorization" },
        "invariants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "https://air.dev/schema/air-0.7.schema.json#/$defs/invariant" }
        },
        "effects": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "https://air.dev/schema/air-0.7.schema.json#/$defs/updateEffect" }
        },
        "idempotency": { "$ref": "https://air.dev/schema/air-0.7.schema.json#/$defs/idempotency" },
        "effect": {
          "oneOf": [
            { "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/createEffect" },
            { "$ref": "https://air.dev/schema/air-0.7.schema.json#/$defs/updateEffect" },
            { "$ref": "#/$defs/deleteEffect" }
          ]
        }
      }
    },
    "commandAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal", "unauthenticatedError", "rules"],
      "properties": {
        "principal": { "$ref": "#/$defs/identifier" },
        "unauthenticatedError": { "$ref": "#/$defs/errorCode" },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "https://air.dev/schema/air-0.5.schema.json#/$defs/inputEqualsPrincipalRule" },
              { "$ref": "https://air.dev/schema/air-0.7.schema.json#/$defs/recordFieldEqualsPrincipalRule" },
              { "$ref": "#/$defs/principalFieldInRule" }
            ]
          }
        }
      }
    },
    "principalFieldInRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "principalField", "values", "error"],
      "properties": {
        "kind": { "const": "principal-field-in" },
        "principalField": { "$ref": "#/$defs/identifier" },
        "values": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "error": { "$ref": "#/$defs/errorCode" }
      }
    },
    "deleteEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "entity", "identify"],
      "properties": {
        "kind": { "const": "delete" },
        "entity": { "$ref": "#/$defs/identifier" },
        "identify": { "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/updateSelector" },
        "preconditions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/precondition" }
        }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations"],
      "properties": { "operations": { "type": "array", "items": { "$ref": "#/$defs/httpOperation" } } }
    },
    "httpOperation": {
      "oneOf": [
        { "$ref": "#/$defs/crudHttpOperation" },
        { "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/commandHttpOperation" }
      ]
    },
    "crudHttpOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method", "path", "entity", "action"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "path": { "type": "string", "pattern": "^/", "minLength": 1, "maxLength": 500 },
        "entity": { "$ref": "#/$defs/identifier" },
        "action": { "enum": ["create", "read", "update", "delete", "list"] },
        "authorization": { "$ref": "#/$defs/crudAuthorization" },
        "collection": { "$ref": "#/$defs/collection" }
      }
    },
    "crudAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal", "rules"],
      "properties": {
        "principal": { "$ref": "#/$defs/identifier" },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "principalField", "values"],
            "properties": {
              "kind": { "const": "principal-field-in" },
              "principalField": { "$ref": "#/$defs/identifier" },
              "values": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "pagination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["defaultLimit", "maxLimit"],
          "properties": {
            "defaultLimit": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "maxLimit": { "type": "integer", "minimum": 1, "maximum": 1000 }
          }
        },
        "filters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["parameter", "field", "operator"],
            "properties": {
              "parameter": { "$ref": "#/$defs/identifier" },
              "field": { "$ref": "#/$defs/identifier" },
              "operator": { "const": "equals" }
            }
          }
        },
        "orderBy": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "direction"],
            "properties": {
              "field": { "$ref": "#/$defs/identifier" },
              "direction": { "enum": ["asc", "desc"] }
            }
          }
        }
      }
    }
  }
}
