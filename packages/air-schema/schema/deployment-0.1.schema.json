{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://air.dev/schema/deployment-0.1.schema.json",
  "title": "AIR Deployment v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "air.dev/deployment/v0.1" },
    "kind": { "const": "Deployment" },
    "metadata": { "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/metadata" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "identifier": { "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/identifier" },
    "environmentName": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "environment": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/environmentName" },
      "additionalProperties": { "$ref": "#/$defs/environmentName" }
    },
    "resource": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "provider"],
          "properties": { "kind": { "const": "broker" }, "provider": { "enum": ["kafka", "rabbitmq", "postgres"] }, "environment": { "$ref": "#/$defs/environment" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "provider"],
          "properties": { "kind": { "const": "cache" }, "provider": { "const": "redis" }, "environment": { "$ref": "#/$defs/environment" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "provider"],
          "properties": { "kind": { "const": "database" }, "provider": { "const": "postgres" }, "environment": { "$ref": "#/$defs/environment" } }
        }
      ]
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "profile", "resources", "bindings", "observability"],
      "properties": {
        "system": { "type": "string", "minLength": 1 },
        "profile": { "enum": ["process", "docker", "compose", "kubernetes", "terraform-kubernetes"] },
        "resources": {
          "type": "object", "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/resource" }
        },
        "bindings": {
          "type": "object", "minProperties": 1,
          "propertyNames": { "type": "string", "minLength": 1 },
          "additionalProperties": { "$ref": "#/$defs/identifier" }
        },
        "observability": {
          "type": "object", "additionalProperties": false,
          "required": ["openTelemetry", "endpointEnvironment"],
          "properties": { "openTelemetry": { "const": true }, "endpointEnvironment": { "$ref": "#/$defs/environmentName" } }
        },
        "components": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": {
            "type": "object", "additionalProperties": false,
            "properties": { "replicas": { "type": "integer", "minimum": 1, "maximum": 10000 } }
          }
        }
      }
    }
  }
}
