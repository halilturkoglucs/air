{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://air.dev/schema/air-0.6.schema.json",
  "title": "AIR Application v0.6",
  "description": "AIR semantics with typed, composable command invariant expressions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "air.dev/v0.6" },
    "kind": { "const": "Application" },
    "metadata": { "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/metadata" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "identifier": { "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/identifier" },
    "errorCode": { "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/errorCode" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entities"],
      "properties": {
        "entities": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/entity" }
        },
        "contracts": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/contract" }
        },
        "principals": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/contract" }
        },
        "commands": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/command" }
        },
        "http": { "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/http" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "effect"],
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "input": { "$ref": "#/$defs/identifier" },
        "output": { "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/commandOutput" },
        "errors": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/errorCode" },
          "additionalProperties": { "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/commandError" }
        },
        "guards": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/existsGuard" }
        },
        "transaction": { "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/transaction" },
        "authorization": { "$ref": "https://air.dev/schema/air-0.5.schema.json#/$defs/authorization" },
        "invariants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/invariant" }
        },
        "effect": {
          "oneOf": [
            { "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/createEffect" },
            { "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/updateEffect" }
          ]
        }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "error"],
      "properties": {
        "condition": { "$ref": "#/$defs/expression" },
        "error": { "$ref": "#/$defs/errorCode" }
      }
    },
    "expression": {
      "oneOf": [
        { "$ref": "#/$defs/comparisonExpression" },
        { "$ref": "#/$defs/allExpression" },
        { "$ref": "#/$defs/anyExpression" },
        { "$ref": "#/$defs/notExpression" }
      ]
    },
    "comparisonExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "operator", "right"],
      "properties": {
        "left": { "$ref": "#/$defs/operand" },
        "operator": {
          "enum": [
            "equals",
            "not-equals",
            "greater-than",
            "greater-than-or-equal",
            "less-than",
            "less-than-or-equal"
          ]
        },
        "right": { "$ref": "#/$defs/operand" }
      }
    },
    "allExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all"],
      "properties": {
        "all": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/expression" } }
      }
    },
    "anyExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["any"],
      "properties": {
        "any": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/expression" } }
      }
    },
    "notExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["not"],
      "properties": { "not": { "$ref": "#/$defs/expression" } }
    },
    "operand": {
      "oneOf": [
        { "$ref": "#/$defs/inputOperand" },
        { "$ref": "#/$defs/recordOperand" },
        { "$ref": "#/$defs/principalOperand" },
        { "$ref": "https://air.dev/schema/air-0.4.schema.json#/$defs/literalReference" }
      ]
    },
    "inputOperand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input"],
      "properties": { "input": { "$ref": "#/$defs/identifier" } }
    },
    "recordOperand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record"],
      "properties": { "record": { "$ref": "#/$defs/identifier" } }
    },
    "principalOperand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal"],
      "properties": { "principal": { "$ref": "#/$defs/identifier" } }
    }
  }
}
