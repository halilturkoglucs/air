{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://air.dev/schema/air-0.2.schema.json",
  "title": "AIR Application v0.2",
  "description": "AIR semantics with explicit identity, generated values, defaults, uniqueness, and relational foreign keys.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "air.dev/v0.2" },
    "kind": { "const": "Application" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 63
        },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entities"],
      "properties": {
        "entities": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/entity" }
        },
        "http": { "$ref": "#/$defs/http" }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/field" }
        },
        "relationships": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/relationship" }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["string", "integer", "number", "boolean", "uuid", "date", "datetime", "json"]
        },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "required": { "type": "boolean" },
        "nullable": { "type": "boolean" },
        "primaryKey": { "type": "boolean" },
        "unique": { "type": "boolean" },
        "generated": { "enum": ["uuid", "auto-increment", "created-at", "updated-at"] },
        "default": {
          "anyOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "null" }
          ]
        },
        "validation": { "$ref": "#/$defs/fieldValidation" }
      }
    },
    "fieldValidation": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 0 },
        "pattern": { "type": "string", "minLength": 1 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "anyOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "cardinality"],
      "properties": {
        "target": { "$ref": "#/$defs/identifier" },
        "cardinality": {
          "enum": ["one-to-one", "one-to-many", "many-to-one", "many-to-many"]
        },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "required": { "type": "boolean" },
        "inverse": { "$ref": "#/$defs/identifier" },
        "sourceField": { "$ref": "#/$defs/identifier" },
        "targetField": { "$ref": "#/$defs/identifier" },
        "onDelete": { "enum": ["restrict", "cascade", "set-null"] }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations"],
      "properties": {
        "operations": {
          "type": "array",
          "items": { "$ref": "#/$defs/httpOperation" }
        }
      }
    },
    "httpOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method", "path", "entity", "action"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "path": { "type": "string", "pattern": "^/", "minLength": 1, "maxLength": 500 },
        "entity": { "$ref": "#/$defs/identifier" },
        "action": { "enum": ["create", "read", "update", "delete", "list"] }
      }
    }
  }
}
