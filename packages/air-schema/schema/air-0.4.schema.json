{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://air.dev/schema/air-0.4.schema.json",
  "title": "AIR Application v0.4",
  "description": "AIR semantics with transactional create and update commands, state preconditions, and optimistic concurrency.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "air.dev/v0.4" },
    "kind": { "const": "Application" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
    "errorCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "primitiveType": {
      "enum": ["string", "integer", "number", "boolean", "uuid", "date", "datetime", "json"]
    },
    "scalar": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" }
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 63
        },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entities"],
      "properties": {
        "entities": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/entity" }
        },
        "contracts": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/contract" }
        },
        "commands": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/command" }
        },
        "http": { "$ref": "#/$defs/http" }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/field" }
        },
        "relationships": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/relationship" }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "$ref": "#/$defs/primitiveType" },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "required": { "type": "boolean" },
        "nullable": { "type": "boolean" },
        "primaryKey": { "type": "boolean" },
        "unique": { "type": "boolean" },
        "generated": { "enum": ["uuid", "auto-increment", "created-at", "updated-at"] },
        "default": { "$ref": "#/$defs/scalar" },
        "validation": { "$ref": "#/$defs/fieldValidation" }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/contractField" }
        }
      }
    },
    "contractField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "$ref": "#/$defs/primitiveType" },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "required": { "type": "boolean" },
        "nullable": { "type": "boolean" },
        "validation": { "$ref": "#/$defs/fieldValidation" }
      }
    },
    "fieldValidation": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 0 },
        "pattern": { "type": "string", "minLength": 1 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/scalar" }
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "cardinality"],
      "properties": {
        "target": { "$ref": "#/$defs/identifier" },
        "cardinality": { "enum": ["one-to-one", "one-to-many", "many-to-one", "many-to-many"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "required": { "type": "boolean" },
        "inverse": { "$ref": "#/$defs/identifier" },
        "sourceField": { "$ref": "#/$defs/identifier" },
        "targetField": { "$ref": "#/$defs/identifier" },
        "onDelete": { "enum": ["restrict", "cascade", "set-null"] }
      }
    },
    "inputReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input"],
      "properties": { "input": { "$ref": "#/$defs/identifier" } }
    },
    "literalReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["literal"],
      "properties": { "literal": { "$ref": "#/$defs/scalar" } }
    },
    "valueReference": {
      "oneOf": [
        { "$ref": "#/$defs/inputReference" },
        { "$ref": "#/$defs/literalReference" }
      ]
    },
    "incrementReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["increment"],
      "properties": { "increment": { "type": "number", "not": { "const": 0 } } }
    },
    "assignment": {
      "oneOf": [
        { "$ref": "#/$defs/inputReference" },
        { "$ref": "#/$defs/literalReference" },
        { "$ref": "#/$defs/incrementReference" }
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "effect"],
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "input": { "$ref": "#/$defs/identifier" },
        "output": { "$ref": "#/$defs/commandOutput" },
        "errors": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/errorCode" },
          "additionalProperties": { "$ref": "#/$defs/commandError" }
        },
        "guards": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/existsGuard" }
        },
        "transaction": { "$ref": "#/$defs/transaction" },
        "effect": {
          "oneOf": [
            { "$ref": "#/$defs/createEffect" },
            { "$ref": "#/$defs/updateEffect" }
          ]
        }
      }
    },
    "commandOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity", "fields"],
      "properties": {
        "entity": { "$ref": "#/$defs/identifier" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "commandError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "message"],
      "properties": {
        "status": { "type": "integer", "minimum": 400, "maximum": 599 },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "retryable": { "type": "boolean" }
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isolation"],
      "properties": {
        "isolation": { "enum": ["read-committed", "repeatable-read", "serializable"] },
        "conflictError": { "$ref": "#/$defs/errorCode" }
      }
    },
    "existsGuard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "entity", "field", "value", "error"],
      "properties": {
        "kind": { "const": "exists" },
        "entity": { "$ref": "#/$defs/identifier" },
        "field": { "$ref": "#/$defs/identifier" },
        "value": { "$ref": "#/$defs/inputReference" },
        "error": { "$ref": "#/$defs/errorCode" }
      }
    },
    "createEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "entity", "values"],
      "properties": {
        "kind": { "const": "create" },
        "entity": { "$ref": "#/$defs/identifier" },
        "values": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/valueReference" }
        }
      }
    },
    "updateSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "value", "error"],
      "properties": {
        "field": { "$ref": "#/$defs/identifier" },
        "value": { "$ref": "#/$defs/valueReference" },
        "error": { "$ref": "#/$defs/errorCode" }
      }
    },
    "precondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "equals", "error"],
      "properties": {
        "field": { "$ref": "#/$defs/identifier" },
        "equals": { "$ref": "#/$defs/valueReference" },
        "error": { "$ref": "#/$defs/errorCode" }
      }
    },
    "updateEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "entity", "identify", "values"],
      "properties": {
        "kind": { "const": "update" },
        "entity": { "$ref": "#/$defs/identifier" },
        "identify": { "$ref": "#/$defs/updateSelector" },
        "preconditions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/precondition" }
        },
        "values": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/assignment" }
        }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations"],
      "properties": {
        "operations": { "type": "array", "items": { "$ref": "#/$defs/httpOperation" } }
      }
    },
    "httpOperation": {
      "oneOf": [
        { "$ref": "#/$defs/crudHttpOperation" },
        { "$ref": "#/$defs/commandHttpOperation" }
      ]
    },
    "crudHttpOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method", "path", "entity", "action"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "path": { "type": "string", "pattern": "^/", "minLength": 1, "maxLength": 500 },
        "entity": { "$ref": "#/$defs/identifier" },
        "action": { "enum": ["create", "read", "update", "delete", "list"] }
      }
    },
    "commandHttpOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method", "path", "command"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "path": { "type": "string", "pattern": "^/", "minLength": 1, "maxLength": 500 },
        "command": { "$ref": "#/$defs/identifier" }
      }
    }
  }
}
