diff --git a/candidate.mjs b/candidate.mjs
index 63a496d..2ac6e32 100644
--- a/candidate.mjs
+++ b/candidate.mjs
@@ -2,12 +2,66 @@ let source = "";
 for await (const chunk of process.stdin) source += chunk;
 const input = JSON.parse(source || "{}");
 
-console.log(JSON.stringify({
-  http: { status: 201, headers: { "content-type": "application/json" }, body: { id: input.documentId, title: input.title } },
-  database: { rows: [{ id: input.documentId, title: input.title }], transaction: { committed: true } },
-  messages: [],
-  outbound: [],
-  ordering: [],
-  failures: [],
-  retryability: false
-}));
+const headers = { "content-type": "application/json" };
+const id = input.documentId;
+const createdAt = input.timestamp;
+const key = input.idempotencyKey;
+
+function out(o) {
+  console.log(JSON.stringify({
+    messages: [], outbound: [], ordering: [], failures: [], retryability: false, ...o
+  }));
+}
+
+function body() {
+  return { id, title: input.title, createdAt };
+}
+
+const prior = input.existing ?? (input.replay ? { id, title: input.title, createdAt } : null);
+const stored = Array.isArray(input.store) ? input.store.find((r) => r.idempotencyKey === key) : null;
+
+if (input.operation !== undefined && input.operation !== "create") {
+  out({
+    http: { status: 400, headers, body: { error: "unsupported_operation" } },
+    database: { rows: [], transaction: { committed: false, rolledBack: false } },
+    failures: [{ type: "validation", status: 400 }]
+  });
+} else if (typeof input.title !== "string" || input.title.trim() === "" || !id) {
+  out({
+    http: { status: 400, headers, body: { error: "invalid_request" } },
+    database: { rows: [], transaction: { committed: false, rolledBack: false } },
+    failures: [{ type: "validation", status: 400 }]
+  });
+} else if (prior || stored) {
+  const row = stored ?? prior;
+  out({
+    http: { status: 200, headers: { ...headers, "idempotent-replay": "true" }, body: { id: row.id, title: row.title, createdAt: row.createdAt ?? createdAt } },
+    database: { rows: [{ id: row.id, title: row.title, createdAt: row.createdAt ?? createdAt }], transaction: { committed: false, rolledBack: false } },
+    ordering: ["replay"]
+  });
+} else {
+  const vendorStatus = input.vendorStatus ?? 200;
+  const outbound = [
+    { vendor: "authorize", documentId: id, status: vendorStatus, idempotencyKey: key }
+  ];
+  if (vendorStatus >= 200 && vendorStatus < 300) {
+    outbound.push({ vendor: "index", documentId: id, title: input.title, timestamp: createdAt, status: vendorStatus, idempotencyKey: key });
+    out({
+      http: { status: 201, headers, body: body() },
+      database: { rows: [{ id, title: input.title, createdAt, idempotencyKey: key }], transaction: { committed: true } },
+      messages: [{ type: "document.created", documentId: id, title: input.title, timestamp: createdAt }],
+      outbound,
+      ordering: ["vendor.authorize", "vendor.index", "database.commit", "event.emit"]
+    });
+  } else {
+    const retryable = vendorStatus >= 500 || vendorStatus === 429 || vendorStatus === 408;
+    out({
+      http: { status: retryable ? 503 : 502, headers, body: { error: retryable ? "vendor_unavailable" : "vendor_rejected" } },
+      database: { rows: [], transaction: { committed: false, rolledBack: true } },
+      outbound,
+      ordering: ["vendor.authorize"],
+      failures: [{ type: "vendor", vendorStatus, status: retryable ? 503 : 502 }],
+      retryability: retryable
+    });
+  }
+}
