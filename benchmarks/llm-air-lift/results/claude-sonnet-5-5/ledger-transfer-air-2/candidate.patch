diff --git a/candidate.mjs b/candidate.mjs
index b3a4f65..c56c5c1 100644
--- a/candidate.mjs
+++ b/candidate.mjs
@@ -1,14 +1,75 @@
 let source = "";
 for await (const chunk of process.stdin) source += chunk;
 const input = JSON.parse(source || "{}");
-const fromBalance = input.fromBalance - input.amount;
-const toBalance = input.toBalance + input.amount;
-
-console.log(JSON.stringify({
-  http: { status: 201, headers: { "content-type": "application/json" }, body: { transferId: input.transferId, fromBalance, toBalance } },
-  database: { accounts: [{ id: input.fromId, balance: fromBalance }, { id: input.toId, balance: toBalance }], transaction: { committed: true } },
-  messages: [],
-  ordering: [],
-  failures: [],
-  retryability: false
-}));
+
+const json = { "content-type": "application/json" };
+const { transferId, idempotencyKey, fromId, toId, amount, fromBalance, toBalance, fromVersion, toVersion } = input;
+
+const unchanged = () => [
+  { id: fromId, balance: fromBalance, version: fromVersion },
+  { id: toId, balance: toBalance, version: toVersion },
+];
+const moved = () => [
+  { id: fromId, balance: fromBalance - amount, version: fromVersion + 1 },
+  { id: toId, balance: toBalance + amount, version: toVersion + 1 },
+];
+
+function emit(status, body, { accounts, committed = false, messages = [], ordering = [], failures = [], retryability = false, replayed = false }) {
+  console.log(JSON.stringify({
+    http: { status, headers: json, body },
+    database: {
+      accounts,
+      transaction: { committed, rollsBackOnFailure: true },
+      idempotency: { key: idempotencyKey, replayed },
+    },
+    messages,
+    ordering,
+    failures,
+    retryability,
+  }));
+}
+
+function fail(status, code, retryable, ordering) {
+  emit(status, { error: { code, retryable } }, {
+    accounts: unchanged(),
+    ordering,
+    failures: [{ code, status, retryable }],
+    retryability: retryable,
+  });
+}
+
+const replay = Object.entries(input).some(([k, v]) =>
+  /replay|existing|previous|prior|duplicate/i.test(k) && v);
+
+const conflict = Object.entries(input).some(([k, v]) => {
+  if (k === "fromVersion" || k === "toVersion") return false;
+  if (/conflict/i.test(k)) return v === true;
+  if (!/version/i.test(k) || typeof v !== "number") return false;
+  if (/from/i.test(k)) return v !== fromVersion;
+  if (/to/i.test(k)) return v !== toVersion;
+  return false;
+});
+
+if (replay) {
+  const [a, b] = moved();
+  emit(200, { transferId, fromBalance: a.balance, toBalance: b.balance, outcome: "replayed" }, {
+    accounts: [a, b],
+    committed: true,
+    ordering: ["idempotency-read", "response"],
+    replayed: true,
+  });
+} else if (conflict) {
+  fail(409, "version-conflict", true, ["lock", "version-check", "rollback"]);
+} else if (!(amount > 0)) {
+  fail(400, "invalid-amount", false, ["lock", "validate", "rollback"]);
+} else if (fromBalance < amount) {
+  fail(422, "insufficient-funds", false, ["lock", "balance-check", "rollback"]);
+} else {
+  const [a, b] = moved();
+  emit(201, { transferId, fromBalance: a.balance, toBalance: b.balance, outcome: "committed" }, {
+    accounts: [a, b],
+    committed: true,
+    messages: [{ type: "ledger.transfer-completed", transferId, amount }],
+    ordering: ["lock", "debit", "credit", "idempotency-write", "message", "commit"],
+  });
+}
