@@ -1,13 +1,76 @@
+import { randomUUID } from "node:crypto";
+
 let source = "";
 for await (const chunk of process.stdin) source += chunk;
 const input = JSON.parse(source || "{}");
 
-console.log(JSON.stringify({
-  http: { status: 201, headers: { "content-type": "application/json" }, body: { id: input.documentId, title: input.title } },
-  database: { rows: [{ id: input.documentId, title: input.title }], transaction: { committed: true } },
-  messages: [],
-  outbound: [],
-  ordering: [],
-  failures: [],
-  retryability: false
-}));
+const store = new Map();
+const json = { "content-type": "application/json" };
+
+function handle(req) {
+  const key = req.idempotencyKey;
+  const out = { http: null, database: { rows: [], transaction: { committed: false } }, messages: [], outbound: [], ordering: [], failures: [], retryability: false };
+
+  if (key !== undefined && store.has(key)) {
+    const prev = store.get(key);
+    if (prev.title !== req.title) {
+      out.http = { status: 409, headers: json, body: { error: "idempotency_key_conflict" } };
+      out.failures.push({ type: "idempotency_conflict" });
+      out.database.transaction = { committed: false, rolledBack: false };
+      return out;
+    }
+    out.http = { status: 201, headers: { ...json, "idempotent-replay": "true" }, body: prev.body };
+    out.database = { rows: [prev.row], transaction: { committed: false, replayed: true } };
+    return out;
+  }
+
+  if (typeof req.title !== "string" || req.title.trim() === "") {
+    out.http = { status: 400, headers: json, body: { error: "invalid_title" } };
+    out.failures.push({ type: "validation", field: "title" });
+    return out;
+  }
+
+  const id = req.documentId ?? randomUUID();
+  const createdAt = req.timestamp ?? new Date().toISOString();
+  const vendorStatus = req.vendorStatus ?? 200;
+
+  out.outbound.push({ target: "vendor", action: "authorize", documentId: id });
+  out.ordering.push("vendor.authorize");
+  let failedAt = vendorStatus >= 400 ? "authorize" : null;
+  if (!failedAt) {
+    out.outbound.push({ target: "vendor", action: "index", documentId: id, title: req.title });
+    out.ordering.push("vendor.index");
+  }
+
+  if (failedAt) {
+    const retryable = vendorStatus === 429 || vendorStatus >= 500;
+    const status = retryable ? 503 : 502;
+    out.http = { status, headers: json, body: { error: retryable ? "vendor_unavailable" : "vendor_rejected" } };
+    out.failures.push({ type: "vendor", stage: failedAt, vendorStatus });
+    out.retryability = retryable;
+    out.database = { rows: [], transaction: { committed: false, rolledBack: true } };
+    return out;
+  }
+
+  const row = { id, title: req.title, createdAt };
+  const body = { id, title: req.title, createdAt };
+  out.http = { status: 201, headers: json, body };
+  out.database = { rows: [row], transaction: { committed: true } };
+  out.ordering.push("db.commit", "event.document.created");
+  out.messages.push({ type: "document.created", documentId: id, title: req.title, timestamp: createdAt });
+  if (key !== undefined) store.set(key, { title: req.title, row, body });
+  return out;
+}
+
+let result;
+if (Array.isArray(input.requests)) {
+  const base = { ...input };
+  delete base.requests;
+  result = handle({ ...base, ...input.requests[0] });
+  for (const r of input.requests.slice(1)) result = handle({ ...base, ...r });
+} else {
+  result = handle(input);
+  if (input.replay) result = handle(input);
+}
+
+console.log(JSON.stringify(result));
